/**
 * 
 * Part E — Running Multiple Async Operations
 * Sequential — One After Another
 */

async function runSequential() {
    console.log("Running tests sequentially...\n");

    let start = Date.now();

    await wait(1000, " Test 1: Login — PASSED");
    await wait(1000, "Test 2: Search — PASSED");
    await wait(1000, " Test 3: Checkout — PASSED");

    let total = ((Date.now() - start) / 1000).toFixed(1);
    console.log(`\n  Total time: ${total}s`); // ~3 seconds
}

runSequential();